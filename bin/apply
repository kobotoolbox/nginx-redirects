#!/usr/bin/env bash
set +eou pipefail

kubectl --context arn:aws:eks:us-east-1:917503078660:cluster/kobo apply -f ./manifest/
kubectl --context arn:aws:eks:us-east-1:917503078660:cluster/kobo -n nginx-redirects create configmap nginx-redirects --from-file=nginx.conf=./support_files/nginx.conf --dry-run=client -o yaml | kubectl -n nginx-redirects patch configmap nginx-redirects --type merge --patch-file /dev/stdin
kubectl --context arn:aws:eks:us-east-1:917503078660:cluster/kobo -n nginx-redirects rollout restart deployment/nginx-redirects
